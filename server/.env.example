# ---- Server port / URLs ----
PORT=4000
CLIENT_URL=http://localhost:5173

# ---- Google OAuth (Gmail integration) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# 1. Create an OAuth 2.0 Client ID (type: Web application)
# 2. Authorized redirect URI: http://localhost:4000/api/auth/google/callback
# 3. Enable the "Gmail API" for your project at
#    https://console.cloud.google.com/apis/library/gmail.googleapis.com
# Leave these blank to run the app in local mock-mail mode (no real Gmail).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---- Gmail real-time sync (optional, production only) ----
# Requires a Google Cloud Pub/Sub topic granted publish rights for
# gmail-api-push@system.gserviceaccount.com. See README "Real-Time Sync".
# Leave blank to use the local polling fallback.
GMAIL_PUBSUB_TOPIC=

# ---- AI (Anthropic) ----
# Create a key at https://console.anthropic.com/settings/keys
# Leave blank to run the app with the assistant panel disabled
# (manual inbox/sent/compose/detail all still work).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ---- Database ----
DATABASE_PATH=./data.sqlite

# ---- Real-time polling fallback interval (ms) ----
MAIL_POLL_INTERVAL_MS=15000

NODE_ENV=development
