# ---- Google OAuth (Gmail integration) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID type: Web application
# Authorized redirect URI:
# http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ---- Gmail real-time sync (optional, production only) ----
# Leave blank to use the local polling fallback.
GMAIL_PUBSUB_TOPIC=

# ---- AI (Google Gemini) ----
# Create an API key at Google AI Studio.
# Leave blank to disable the AI assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Database ----
DATABASE_PATH=./data.sqlite

# ---- Real-time polling fallback interval (ms) ----
MAIL_POLL_INTERVAL_MS=15000

NODE_ENV=development